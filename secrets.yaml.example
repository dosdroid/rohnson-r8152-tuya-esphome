# Copy this file to secrets.yaml (same directory) and fill in your own
# values. secrets.yaml is gitignored and never committed.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Generate with: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "base64-encoded-32-byte-key=="

# Password for the fallback WiFi hotspot the device starts if it can't join
# your network.
ap_fallback_password: "choose-a-strong-password"

# Password required to push OTA firmware updates to the device.
ota_password: "choose-a-strong-password"
